# Développement local : copier en apps/api/.env (facultatif, valeurs par défaut raisonnables).
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
# Sans DATABASE_URL : base PGlite embarquée dans ./.data/pglite
# DATABASE_URL=postgres://saytumbay:motdepasse@localhost:5432/saytumbay
SEED_DEMO=true
DEMO_LOGIN=true
SIMULATOR=true
SMS_PROVIDER=console
WEATHER=open-meteo
