# Copier en infra/.env et remplir. Ne jamais versionner infra/.env.
DOMAIN=saytumbay.com
ACME_EMAIL=contact@saytumbay.com

# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -hex 32   (chiffrement des secrets de double authentification ; à sauvegarder hors du serveur)
ENCRYPTION_KEY=
# openssl rand -base64 24
MQTT_API_PASSWORD=

# SMS : "console" (journaux) ou "orange" (API SMS Orange, contrat requis)
SMS_PROVIDER=console
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER=
ORANGE_SENDER_NAME=SaytuMbay

# Démo publique sur le vrai serveur (données fictives) : laisser à false en exploitation réelle.
SEED_DEMO=false
DEMO_LOGIN=false
SIMULATOR=false

# Sauvegardes (infra/scripts/backup.sh)
BACKUP_DIR=/var/backups/saytumbay
# openssl rand -base64 32 — conserver aussi hors du serveur, sans elle les sauvegardes sont illisibles
BACKUP_PASSPHRASE=
